                [" and ", false, false],
                ["go", false, false]
            ]
        },
        {
            "line": "**`docker compose up`** in `code/`",
            "runs": [
                ["docker compose up", true, true],
                [" in ", false, false],
                ["code/", false, true]
            ]
        },
        {
