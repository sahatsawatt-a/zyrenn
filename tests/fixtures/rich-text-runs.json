            "runs": [
                ["see ", false, false],
                ["x_y", false, true]
            ]
        },
        {
            "line": "\\_private\\_ and 2 \\* 3 and \\`x\\`",
            "runs": [["_private_ and 2 * 3 and `x`", false, false]]
        },
        {
            "line": "**bold** then plain",
            "runs": [
                ["bold", true, false],
                [" then plain", false, false]
            ]
        }
