APP_NAME="ZyrenN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=zyrenn
DB_USERNAME=zyrenn
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###> docker ####################################################################
# The host user, so bind-mounted storage/ and bootstrap/cache/ stay writable.
# compose reads these from here: UID is a readonly bash variable that never
# reaches a child process, so `${UID:-1000}` in the compose file would silently
# fall back to 1000 and rebuild the image for the wrong user.
UID=1000
GID=1000

# Host ports. Change when something else already occupies them on this machine.
APP_PORT=8001
VITE_PORT=5173
FORWARD_DB_PORT=5434

# Start the Vite dev server (HMR). Leave this unset to serve the built assets
# from public/build instead -- that is the mode to use when exposing the app
# over a tunnel or IP:PORT, since the dev server is only reachable locally.
# Build them first: docker compose run --rm app npm run build
#
# When exposing the app to anyone else, also set APP_DEBUG=false above --
# with it on, any 500 response renders a stack trace including config values.
COMPOSE_PROFILES=dev

# Origin the browser uses to reach Vite. Only change it if a proxy fronts Vite.
# VITE_DEV_ORIGIN=http://localhost:5173

# Machines running the shared Traefik proxy opt in here; see
# docker-compose.traefik.yml for the full list of variables it expects.
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# APP_HOST=zyrenn.example.test
# VITE_HOST=zyrenn-vite.example.test
###< docker ####################################################################
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8001
VITE_REVERB_SCHEME=http

# Bearer token for the app-level MCP server (/mcp/global). Leave empty to disable it.
# Generate one with: openssl rand -hex 32
MCP_GLOBAL_TOKEN=

# Inertia server-side rendering. Turn on only with a built SSR bundle and
# `php artisan inertia:start-ssr` running; leave off for local development.
INERTIA_SSR_ENABLED=false

# Live co-editing of notes and boards (collab/server.mjs, the `collab` service).
# Leave COLLAB_URL empty to turn it off. Set COLLAB_SECRET to a long random string.
COLLAB_URL=http://collab:1234
COLLAB_SECRET=
